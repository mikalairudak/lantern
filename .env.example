# Names only, no values: copy to .env.local and fill in there; Vercel's environments hold
# their own.

# Geoapify geocoding, read only on the server (src/lib/places/server.ts).
GEOAPIFY_API_KEY=

# Claude, read by @ai-sdk/anthropic: a lantern-dev key on the laptop and in preview deploys,
# a lantern-prod key in production.
ANTHROPIC_API_KEY=

# Live generation: only the exact value 1 turns it on; anything else, unset included, is off.
LIVE_GENERATION=

# The first impression's start screen, masthead and day: only the exact value 1 turns it on,
# and a page takes it when it is built, so a change needs a new build.
FIRST_IMPRESSION=

# Salts the hash a visitor's limits are counted under, so the hash cannot be reversed by
# hashing every address. Any long random string; changing it starts every count afresh.
VISITOR_HASH_SALT=

# Postgres on Neon for the limits' counters and the generation log: the pooled string, which
# the HTTP driver reads. Unset, a laptop counts in memory; preview and production refuse to
# call a model without it (src/lib/live/flag.ts).
DATABASE_URL=

# The direct string, read only by `pnpm db:migrate`, which falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=

# The studio's password (/studio and /lab), set only in the environment (docs/ops.md, "The
# studio's password"). Unset, `pnpm dev` leaves the studio open; production shuts it.
STUDIO_PASSWORD=
