{
  "name": "lantern",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "dev:lan": "next dev -H 0.0.0.0",
    "build": "next build",
    "build:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-check.mts",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:visual": "playwright test --project=visual",
    "e2e:busy": "E2E_CPU_RATE=${E2E_CPU_RATE:-2} playwright test",
    "e2e:replan-pace": "playwright test e2e/replan-story.spec.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage",
    "days:fresh": "vitest run --config vitest.days-fresh.config.mts",
    "db:migrate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/db-migrate.mts",
    "eval:live": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run --config vitest.live-eval.config.mts",
    "eval:table": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/eval-table.mts",
    "events:report": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/events-report.mts",
    "log:report": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/log-report.mts",
    "prepare": "git config core.hooksPath >/dev/null || git config core.hooksPath .githooks || true",
    "prod:read": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/prod-read.mts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.85",
    "@neondatabase/serverless": "1.2.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/functions": "3.10.4",
    "ai": "7.0.148",
    "lucide-react": "^1.59.0",
    "motion": "^14.4.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "jsdom": "^27.0.1",
    "pg": "8.23.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24 <25"
  }
}
